# Streamlit Community Cloud > App settings > Secrets OU Manage App > Secrets
[databricks]
server_hostname = "<url-id>.cloud.databricks.com"
http_path = "/sql/1.0/warehouses/<http-path-id>" # SQL > SQL Warehouses
access_token = "<token>" # Profile > Settings > User > Developer > Access tokens
catalog = "workspace"
schema = "news_recsys_dev"   # app QA: news_recsys_qa - app PROD: news_recsys_prod